{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Layout Region Schema",
  "type": "object",
  "required": [
    "region_id",
    "document_id",
    "page_number",
    "region_type",
    "bbox",
    "coordinate_system"
  ],
  "properties": {
    "region_id": { "type": "string" },
    "document_id": { "type": "string" },
    "page_number": { "type": "integer", "minimum": 1 },
    "region_type": {
      "type": "string",
      "enum": [
        "title",
        "section_header",
        "paragraph",
        "table",
        "figure",
        "caption",
        "list",
        "header",
        "footer",
        "footnote",
        "formula",
        "form_field"
      ]
    },
    "bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "coordinate_system": {
      "type": "object",
      "required": ["units", "origin", "page_width", "page_height"],
      "properties": {
        "units": { "type": "string", "enum": ["normalized", "points", "pixels"] },
        "origin": { "type": "string", "enum": ["top_left", "bottom_left"] },
        "page_width": { "type": "number", "minimum": 0 },
        "page_height": { "type": "number", "minimum": 0 }
      }
    },
    "text_reference": { "type": ["string", "null"] },
    "confidence": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
  }
}
