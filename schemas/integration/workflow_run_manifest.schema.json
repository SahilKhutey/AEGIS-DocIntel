{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-docintel.io/schemas/integration/workflow_run_manifest.schema.json",
  "title": "AEGIS-DocIntel Workflow Run Manifest",
  "type": "object",
  "required": [
    "workflow_run_id",
    "work_package",
    "scenario_id",
    "dataset_version",
    "document_ids",
    "pipeline_version",
    "processing_config_version",
    "intelligence_config_version",
    "evaluation_manifest_id",
    "started_at",
    "status"
  ],
  "properties": {
    "workflow_run_id": {
      "type": "string",
      "pattern": "^wp08-run-[0-9a-zA-Z_-]+$"
    },
    "work_package": {
      "type": "string",
      "enum": ["WP-08"]
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^WF-[0-9]{3}$"
    },
    "dataset_version": {
      "type": "string"
    },
    "document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "pipeline_version": {
      "type": "string"
    },
    "processing_config_version": {
      "type": "string"
    },
    "intelligence_config_version": {
      "type": "string"
    },
    "evaluation_manifest_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["RUNNING", "PASSED", "FAILED", "ABORTED"]
    },
    "stage_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_name", "status", "duration_ms"],
        "properties": {
          "stage_name": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "SKIPPED"] },
          "duration_ms": { "type": "number" },
          "details": { "type": "object" }
        }
      }
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
