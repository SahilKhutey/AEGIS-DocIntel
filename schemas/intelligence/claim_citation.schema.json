{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Claim and Citation Support Evaluation Schema",
  "type": "object",
  "required": [
    "answer_id",
    "claims",
    "evaluation_summary"
  ],
  "properties": {
    "answer_id": { "type": "string" },
    "question_id": { "type": "string" },
    "answer_text": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "text", "citations", "support_status"],
        "properties": {
          "claim_id": { "type": "string" },
          "text": { "type": "string" },
          "citations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "citation_id",
                "document_id",
                "support_label"
              ],
              "properties": {
                "citation_id": { "type": "string" },
                "document_id": { "type": "string" },
                "page_number": { "type": ["integer", "null"] },
                "region_id": { "type": ["string", "null"] },
                "chunk_id": { "type": ["string", "null"] },
                "support_label": {
                  "type": "string",
                  "enum": [
                    "SUPPORTS",
                    "PARTIALLY_SUPPORTS",
                    "CONTRADICTS",
                    "RELATED_ONLY",
                    "IRRELEVANT",
                    "INVALID_REFERENCE",
                    "INSUFFICIENT_CONTEXT"
                  ]
                },
                "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "rationale": { "type": "string" }
              }
            }
          },
          "support_status": {
            "type": "string",
            "enum": ["FULLY_SUPPORTED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "CONTRADICTED"]
          }
        }
      }
    },
    "evaluation_summary": {
      "type": "object",
      "required": [
        "citation_precision",
        "claim_support_rate",
        "citation_coverage",
        "unsupported_claim_rate"
      ],
      "properties": {
        "citation_precision": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "claim_support_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "citation_coverage": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "unsupported_claim_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "total_claims": { "type": "integer" },
        "total_citations": { "type": "integer" }
      }
    }
  }
}
