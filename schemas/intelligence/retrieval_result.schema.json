{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Canonical Retrieval Result Schema",
  "type": "object",
  "required": [
    "query_id",
    "retrieval_mode",
    "query",
    "filters",
    "results",
    "latency_ms"
  ],
  "properties": {
    "query_id": { "type": "string" },
    "retrieval_mode": {
      "type": "string",
      "enum": ["lexical", "semantic", "hybrid", "structured"]
    },
    "query": { "type": "string" },
    "filters": { "type": "object" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "chunk_id",
          "page_number",
          "text",
          "rank",
          "score",
          "retrieval_method",
          "source_reference"
        ],
        "properties": {
          "document_id": { "type": "string" },
          "chunk_id": { "type": "string" },
          "page_number": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "rank": { "type": "integer", "minimum": 1 },
          "score": { "type": "number" },
          "retrieval_method": { "type": "string" },
          "source_reference": { "type": "string" },
          "metadata": { "type": "object" }
        }
      }
    },
    "latency_ms": { "type": "number", "minimum": 0.0 }
  }
}
