{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Canonical Evaluation Item Schema",
  "type": "object",
  "required": [
    "item_id",
    "document_id",
    "task",
    "input",
    "ground_truth"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "task": {
      "type": "string"
    },
    "input": {
      "type": "object"
    },
    "ground_truth": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "object" }
    },
    "annotation_version": {
      "type": "string"
    }
  }
}
