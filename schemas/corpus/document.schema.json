{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Canonical Corpus Document Schema",
  "type": "object",
  "required": [
    "document_id",
    "source_id",
    "dataset_id",
    "content",
    "metadata",
    "rights"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[A-Z0-9_-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9_-]+$"
    },
    "dataset_id": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "required": ["uri", "format", "sha256"],
      "properties": {
        "uri": { "type": "string" },
        "format": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["title", "document_type"],
      "properties": {
        "title": { "type": "string" },
        "document_type": { "type": "string" },
        "language": { "type": "array", "items": { "type": "string" } },
        "page_count": { "type": "integer", "minimum": 1 },
        "publication_date": { "type": "string" },
        "publisher": { "type": "string" }
      }
    },
    "rights": {
      "type": "object",
      "required": ["licence_id", "status"],
      "properties": {
        "licence_id": { "type": "string", "pattern": "^LIC-[A-Z0-9_-]+$" },
        "status": { "type": "string", "enum": ["APPROVED", "CONDITIONAL", "PENDING", "REJECTED"] },
        "attribution_required": { "type": "boolean" },
        "attribution_text": { "type": "string" }
      }
    }
  }
}
