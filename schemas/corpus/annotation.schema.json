{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Canonical Corpus Annotation Schema",
  "type": "object",
  "required": [
    "annotation_id",
    "document_id",
    "task",
    "schema_version",
    "labels"
  ],
  "properties": {
    "annotation_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string"
    },
    "task": {
      "type": "string",
      "enum": [
        "document_classification",
        "ocr_evaluation",
        "layout_detection",
        "entity_extraction",
        "table_extraction",
        "question_answering",
        "citation_validation",
        "document_retrieval",
        "cross_document_analysis"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "labels": {
      "type": "object"
    },
    "bounding_boxes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "bbox", "category"],
        "properties": {
          "page": { "type": "integer" },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "category": { "type": "string" }
        }
      }
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "chunk_id": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    }
  }
}
