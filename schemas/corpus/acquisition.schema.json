{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Corpus Acquisition Decision Schema",
  "type": "object",
  "required": [
    "decision_id",
    "source_id",
    "status",
    "permitted_uses",
    "approved_by",
    "approved_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-[A-Z0-9_-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^SRC-[A-Z0-9_-]+$"
    },
    "dataset_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED", "CONDITIONAL", "PENDING", "REJECTED"]
    },
    "permitted_uses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prohibited_uses": {
      "type": "array",
      "items": { "type": "string" }
    },
    "conditions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string"
    },
    "justification": {
      "type": "string"
    }
  }
}
