{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AEGIS Security & Reliability Benchmark Report Schema",
  "type": "object",
  "required": [
    "benchmark_id",
    "run_id",
    "work_package",
    "capability",
    "pipeline_version",
    "configuration_hash",
    "metrics",
    "resource_metrics",
    "execution_status"
  ],
  "properties": {
    "benchmark_id": { "type": "string" },
    "run_id": { "type": "string" },
    "work_package": { "type": "string", "enum": ["WP-07"] },
    "capability": {
      "type": "string",
      "enum": [
        "authentication",
        "authorization",
        "tenant_isolation",
        "privacy_detection",
        "document_deletion",
        "worker_reliability",
        "backup_restoration",
        "integrated_security"
      ]
    },
    "pipeline_version": { "type": "string" },
    "configuration_hash": { "type": "string" },
    "software_versions": { "type": "object" },
    "metrics": { "type": "object" },
    "resource_metrics": { "type": "object" },
    "test_cases": {
      "type": "array",
      "items": { "$ref": "test_result.schema.json#" }
    },
    "errors": { "type": "array" },
    "execution_status": {
      "type": "string",
      "enum": ["COMPLETED", "FAILED"]
    }
  }
}
