# ==============================================================================
# AEGIS-DocIntel — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.production on deployment host.
# NEVER commit .env.production or real production secrets to version control.

# Required deployment release tag
AEGIS_IMAGE_TAG=0.1.0-alpha.1

# Pinned monitoring images (update deliberately with verified releases/digests)
PROMETHEUS_IMAGE=prom/prometheus:v2.50.1
GRAFANA_IMAGE=grafana/grafana:10.4.1

# Required Grafana credentials — replace with generated secure secrets
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Production JWT identity provider configuration
AEGIS_JWT_ISSUER=https://auth.example.com
AEGIS_JWT_AUDIENCE=aegis-docintel
AEGIS_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Keep disabled unless you have explicitly authorized external cloud LLM egress
AEGIS_ALLOW_EXTERNAL_LLM=false
