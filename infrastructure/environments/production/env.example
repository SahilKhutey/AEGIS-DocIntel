# AEGIS-DocIntel Production Environment Configuration Template
# For protected evaluation platform. Secrets injected via Docker secrets / KMS.
APP_ENV=production
AEGIS_DEBUG=false
DATABASE_URL_FILE=/run/secrets/production_database_url
AEGIS_INTERNAL_SERVICE_SECRET_FILE=/run/secrets/production_internal_secret
AEGIS_OPENAI_API_KEY_FILE=/run/secrets/production_openai_key
AEGIS_ANTHROPIC_API_KEY_FILE=/run/secrets/production_anthropic_key
AEGIS_GATEWAY_URL=https://gateway.aegis-docintel.internal
AEGIS_MIN_CLIENT_VERSION=1.0.0
