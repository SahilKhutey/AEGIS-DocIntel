# AEGIS-DocIntel Staging Environment Configuration Template
# For pre-release adversarial penetration testing and security staging.
APP_ENV=staging
AEGIS_DEBUG=false
DATABASE_URL_FILE=/run/secrets/staging_database_url
AEGIS_INTERNAL_SERVICE_SECRET_FILE=/run/secrets/staging_internal_secret
AEGIS_OPENAI_API_KEY_FILE=/run/secrets/staging_openai_key
AEGIS_GATEWAY_URL=https://staging-gateway.aegis-docintel.internal
