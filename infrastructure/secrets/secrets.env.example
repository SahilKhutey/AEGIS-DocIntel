# AEGIS-DocIntel Secrets Inventory & Injection Template
# DO NOT COMMIT ACTUAL PLAINTEXT PRODUCTION SECRETS TO SOURCE CONTROL
# Inject via Docker Secrets (/run/secrets/...) or Vault / AWS KMS in production

# 1. Database Credentials
DATABASE_URL=postgresql://aegis_app:[REDACTED_PASSWORD]@database:5432/aegis_production
DATABASE_PASSWORD=[REDACTED_PASSWORD]

# 2. Internal Service-to-Service Secret (HMAC-SHA256)
AEGIS_INTERNAL_SERVICE_SECRET=[REDACTED_HIGH_ENTROPY_HEX_SECRET]

# 3. Model Provider Credentials
AEGIS_OPENAI_API_KEY=sk-[REDACTED_OPENAI_KEY]
AEGIS_ANTHROPIC_API_KEY=sk-ant-[REDACTED_ANTHROPIC_KEY]

# 4. Identity & Licensing Private Keys (PEM format stored in KMS)
AEGIS_JWT_PRIVATE_KEY=[REDACTED_PRIVATE_KEY_PEM]
AEGIS_LICENSE_PRIVATE_KEY=[REDACTED_PRIVATE_KEY_PEM]
