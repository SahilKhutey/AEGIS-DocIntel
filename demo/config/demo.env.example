# =================================================================
# AEGIS-DocIntel — Demo Environment Configuration (.env)
# =================================================================
# Purpose: Configure isolated sandbox mode for Product Hunt live demo.

# Core Environment
AEGIS_ENVIRONMENT=demo
AEGIS_DEMO_MODE=true
AEGIS_DEMO_ALLOW_ANONYMOUS=true
AEGIS_LOG_LEVEL=INFO

# Demo Auth & Scoped Credentials
AEGIS_DEMO_TOKEN=aegis-demo-token-sandbox
AEGIS_DEMO_API_KEY=aegis-demo-public-key
AEGIS_DEMO_RESET_KEY=aegis-demo-reset-secret-2026

# Storage & Database Isolation
AEGIS_SQLITE_PATH=/app/data/demo_documents.db
AEGIS_AUDIT_LOG_PATH=/app/data/demo_audit.log
TIKTOKEN_CACHE_DIR=/tmp/tiktoken

# Public API Ingress & CORS
NEXT_PUBLIC_AEGIS_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://demo.aegis-docintel.com"]

# Resource & Rate Limits
AEGIS_MAX_UPLOAD_BYTES=15728640
AEGIS_REQUEST_TIMEOUT_SECONDS=45.0
AEGIS_ALLOW_EXTERNAL_LLM=false

# Ports & Bindings
AEGIS_API_HOST=0.0.0.0
AEGIS_API_PORT=8000
PORT=8000
