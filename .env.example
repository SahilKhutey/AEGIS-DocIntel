# ==============================================================================
# AEGIS-DocIntel — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit real credentials.

# --- Runtime & Application ---
AEGIS_ENVIRONMENT=development             # development | test | staging | production
AEGIS_LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
AEGIS_SQLITE_PATH=data/documents.db       # Path to persistent SQLite database
AEGIS_MAX_UPLOAD_BYTES=209715200          # 200 MB maximum upload limit in bytes
AEGIS_REQUEST_TIMEOUT_SECONDS=30.0        # Default request timeout in seconds
AEGIS_MAX_CONCURRENT_JOBS=10              # Maximum concurrent processing jobs
AEGIS_ENABLE_DOCS=true                    # Enable /docs and /redoc (false in production)
AEGIS_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Authentication & Authorization ---
# In development, a bypass bearer token 'dev-token' is permitted.
# In production, at least one of JWT or API Keys MUST be configured:
AEGIS_JWT_PUBLIC_KEY=                     # PEM encoded RSA public key string
AEGIS_JWT_PUBLIC_KEY_PATH=                # Path to RSA public key .pem file
AEGIS_JWT_ISSUER=https://auth.aegis.corp  # Required if JWT is configured
AEGIS_JWT_AUDIENCE=aegis-docintel         # Required if JWT is configured

# Format: tenant_id:role:sha256:<64-character-hex-hash>;...
# Never store raw API keys in production configuration!
AEGIS_API_KEYS=

# --- External LLM & Privacy Policy ---
AEGIS_LLM_PROVIDER=mock                   # mock | openai | anthropic | google | vllm
AEGIS_ALLOW_EXTERNAL_LLM=false            # Explicit consent to transfer data outside security boundary
OPENAI_API_KEY=
VLLM_ENDPOINT=

# --- Observability & Telemetry ---
AEGIS_ENABLE_METRICS=true                 # Enable Prometheus /metrics
AEGIS_METRICS_PORT=9090                   # Metrics server port
AEGIS_PSEUDONYMIZE_TELEMETRY=true         # Replace raw tenant IDs with HMAC/SHA-256 hashes

# --- Production Deployment (Docker Compose) ---
GRAFANA_ADMIN_PASSWORD=                    # Required for production Grafana; changeme is rejected
