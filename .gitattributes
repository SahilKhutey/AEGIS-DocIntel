# Preserve binary files without text conversion in git diff
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.tar.gz binary
*.whl binary

# Preserve exact line endings for evaluation golden fixtures across platforms
evaluation/mvp-golden/** text eol=lf
evaluation/datasets/** text eol=lf
evaluation/** text eol=lf
configs/evaluation/** text eol=lf
release/final-verification/** text eol=lf
release/** text eol=lf
openapi.json text eol=lf
